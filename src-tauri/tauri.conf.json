{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pydinary",
  "version": "0.1.0",
  "identifier": "com.laris.pydinary",
  "build": {
    "beforeDevCommand": "npm run gen-icons",
    "beforeBuildCommand": "npm run gen-icons",
    "frontendDist": "https://pydinary.pages.dev/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pydinary",
        "url": "https://pydinary.pages.dev/"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
